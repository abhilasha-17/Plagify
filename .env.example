# ─────────────────────────────────────────────────────────────
# Plagify frontend – environment variables
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# Every var below is OPTIONAL – the app runs with sensible
# defaults if none are set.
# ─────────────────────────────────────────────────────────────

# Base URL of the plagiarism / code-quality backend service.
# Consumed SERVER-SIDE only by the Next.js API routes in app/api/*.
# Do NOT add a trailing slash and do NOT include the /compare path.
# Default: the hosted Render service shown below.
PLAGIARISM_API_BASE_URL=https://ai-plagiarism-checker-and-quality-scorer.onrender.com

# Client-side endpoint overrides (exposed to the browser).
# Leave commented to let the UI call the internal Next.js API
# routes (recommended). Only set these to make the browser hit a
# backend directly, bypassing app/api/*.
# NEXT_PUBLIC_COMPARE_ENDPOINT=/api/compare
# NEXT_PUBLIC_BULK_COMPARE_ENDPOINT=/api/bulk-compare
